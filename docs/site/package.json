{
  "name": "fcc-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names guide,reference \"astro dev --host 0.0.0.0\" \"vitepress dev reference --host 127.0.0.1 --port 4322 --strictPort\"",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "prebuild": "node sync-legacy.mjs",
    "predev": "node sync-legacy.mjs",
    "postbuild": "vitepress build reference && node finalize-reference.mjs && pagefind --site dist",
    "reference:dev": "vitepress dev reference --host 0.0.0.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/starlight": "0.43.2",
    "@cloudflare/nimbus-docs": "0.20.2",
    "astro": "7.4.13",
    "concurrently": "9.2.5",
    "pagefind": "1.6.0",
    "vitepress": "2.0.0-alpha.21"
  }
}
